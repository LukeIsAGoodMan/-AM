# Copy to .env.local and adjust if needed.
# Defaults match docker-compose.yml.

DATABASE_URL=postgresql://am:am_dev@localhost:5432/am

# ── Admin edit gate (deploy) ─────────────────────────────────────────────
# Viewing the admin site is open; MAKING CHANGES requires this password.
# Every mutating server action refuses without it (server-side), so editing
# is impossible even by calling the action directly.
ADMIN_EDIT_PASSWORD=change-me
# HMAC key that signs the "edit unlocked" cookie (carries a server-enforced 12h
# expiry) so it can't be forged. REQUIRED in production: if this and
# ADMIN_EDIT_PASSWORD are both unset in prod, the gate FAILS CLOSED (stays locked)
# rather than falling back to a guessable constant. Use a long random string,
# e.g. `openssl rand -hex 32`. Local dev has a fixed insecure fallback.
EDIT_COOKIE_SECRET=change-me-to-a-long-random-string
